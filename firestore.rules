rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownerOfPost(postId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/tagPosts/$(postId)).data.ownerId == request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == 'admin';
    }

    // Member profiles (AuthContext) — everyone signed in can see the roster,
    // but only the account owner can create/update/delete their own doc.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSelf(userId);
    }

    // Timeline/Memory photos (PhotoContext) — readable by anyone signed in,
    // writable only by the uploader.
    match /photos/{photoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uploaderId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uploaderId == request.auth.uid;
    }

    // Anonymous Tagging posts (TagContext) — owner-only write access.
    // Deleted once published to Memory (see publishRequests below).
    match /tagPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Tag suggestions ("나예요" / "제보") — anyone can submit. Three-stage
    // review: an admin verifies identity, then (for self-claims) the
    // submitter states their own mosaic/publish preferences, then the post
    // owner decides whether to make it public. Each stage's writer may only
    // touch the field(s) that stage owns — otherwise a submitter could set
    // status straight to 'owner_approved' themselves, or an owner could
    // approve a suggestion admin never reviewed.
    match /tagSuggestions/{suggestionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.submitterId == request.auth.uid;

      // Stage 1 — admin moves pending -> admin_approved/admin_rejected only.
      allow update: if isAdmin() &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['admin_approved', 'admin_rejected'];

      // Stage 2 — the submitter states their own preferences exactly once,
      // only after admin approval, only on their own suggestion.
      allow update: if isSignedIn() &&
        resource.data.submitterId == request.auth.uid &&
        resource.data.status == 'admin_approved' &&
        !('wantsMosaicRemoved' in resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['wantsMosaicRemoved', 'wantsPublish']);

      // Stage 3 — the post owner moves admin_approved -> owner_approved/
      // owner_rejected only, and only once a self-claim's own preferences
      // (if any) are already in place.
      allow update: if ownerOfPost(resource.data.postId) &&
        resource.data.status == 'admin_approved' &&
        (resource.data.taggedUserId != resource.data.submitterId ||
          'wantsMosaicRemoved' in resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['owner_approved', 'owner_rejected'];
    }

    // "Memory에 올려도 될까요?" publish requests — anyone can ask, only the
    // tag post owner can approve/reject.
    match /publishRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.requesterId == request.auth.uid;
      allow update: if ownerOfPost(resource.data.postId);
    }

    // In-app notifications — any signed-in user can create a notification
    // for someone else (tag/publish/report flows all notify other users),
    // but only the recipient can read or mark it.
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Time capsules (CapsuleContext) — visible/updatable by sender or
    // recipient only.
    match /capsules/{capsuleId} {
      allow read, update: if isSignedIn() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.recipientId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
    }

    // Reports (ReportContext) — reporter can create/read their own reports.
    match /reports/{reportId} {
      allow read: if isSignedIn() && resource.data.reporterId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
    }

    // Per-user block lists — only the owner can read/write their own doc.
    match /blocks/{userId} {
      allow read, write: if isSelf(userId);
    }
  }
}
